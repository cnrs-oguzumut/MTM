# ==================================================================
#  Makefile.tchenla - Optimized for Tchenla Cluster (OpenHPC / Rocky 9)
#  Paris 13 University (Université Sorbonne Paris Nord)
# ==================================================================
#
# Recommended module loading on Tchenla:
#   module purge
#   module load gnu14/14.2.0
#   module load openmpi5/5.0.7
#   module load openblas/0.3.29
#   module load boost/1.88.0
#   module load cgal/5.6.2
#   module load armadillo/14.4.0
#   module load eigen/3.4.0
#
# Usage:
#   make -f Makefile.tchenla -j 8
#   make -f Makefile.tchenla info
#   make -f Makefile.tchenla clean
# ==================================================================

# --- 1. Compiler Configuration ---
CXX      ?= g++
CC       ?= gcc

CXXFLAGS := -O3 -std=c++17 -march=native -fopenmp \
            -fno-math-errno -ffinite-math-only -funroll-loops \
            -DNDEBUG -w

# Preprocessor definitions required by simulation code
DEFINES  := -DUSE_ARMADILLO=1 -DUSE_SPECTRA=1 -DUSE_ITENSOR=1

# Helper macros: ONLY add -I or -L flags if the directory actually exists on disk
add_inc = $(foreach d,$(1),$(if $(wildcard $(d)),-I$(d)))
add_lib = $(foreach d,$(1),$(if $(wildcard $(d)),-L$(d) -Wl,-rpath,$(d)))

# --- 2. OpenHPC Cluster Modules Auto-Detection ---
OHPC_ROOT := /opt/ohpc/pub

# Boost (module: boost/1.88.0)
BOOST_ROOT := $(firstword $(BOOST_DIR) \
                          $(wildcard $(OHPC_ROOT)/libs/gnu14/openmpi5/boost/*) \
                          $(wildcard $(OHPC_ROOT)/libs/gnu14/boost/*) \
                          /usr)

# CGAL (module: cgal/5.6.2)
CGAL_ROOT  := $(firstword $(CGAL_DIR) \
                          $(wildcard $(OHPC_ROOT)/libs/gnu14/cgal/*) \
                          /usr)

# Armadillo (module: armadillo/14.4.0)
ARMADILLO_ROOT := $(firstword $(ARMADILLO_DIR) \
                              $(wildcard $(OHPC_ROOT)/libs/gnu14/armadillo/*) \
                              /usr)

# OpenBLAS (module: openblas/0.3.29)
OPENBLAS_ROOT  := $(firstword $(OPENBLAS_DIR) \
                              $(wildcard $(OHPC_ROOT)/libs/gnu14/openblas/*) \
                              /usr)

# Eigen3 (module: eigen/3.4.0)
EIGEN_ROOT     := $(firstword $(EIGEN_DIR) \
                              $(wildcard $(OHPC_ROOT)/apps/eigen/*) \
                              $(wildcard $(OHPC_ROOT)/libs/gnu14/eigen/*) \
                              $(wildcard $(OHPC_ROOT)/libs/gnu14/eigen3/*) \
                              /usr)

# --- 3. User Libraries (ALGLIB, ITensor, Spectra) ---
MY_LIB_ROOT ?= $(HOME)/required_libraries

ALGLIB_DIR  ?= $(firstword $(wildcard $(HOME)/required_libraries/alglib-cpp) \
                           $(wildcard /home/usalman/required_libraries/alglib-cpp) \
                           $(wildcard ./alglib-cpp) \
                           $(wildcard $(HOME)/alglib-cpp) \
                           $(wildcard $(HOME)/libs/alglib-cpp) \
                           $(wildcard ../alglib-cpp))

ITENSOR_DIR ?= $(firstword $(wildcard $(HOME)/required_libraries/itensor) \
                           $(wildcard /home/usalman/required_libraries/itensor) \
                           $(wildcard $(HOME)/required_libraries/ITensor) \
                           $(wildcard ./itensor) \
                           $(wildcard ./ITensor) \
                           $(wildcard $(HOME)/itensor) \
                           $(wildcard $(HOME)/ITensor) \
                           $(wildcard $(HOME)/libs/itensor) \
                           $(wildcard ../itensor))

SPECTRA_DIR ?= $(firstword $(wildcard $(HOME)/required_libraries/spectra) \
                           $(wildcard /home/usalman/required_libraries/spectra) \
                           $(wildcard ./spectra) \
                           $(wildcard $(HOME)/spectra) \
                           $(wildcard $(HOME)/libs/spectra))

# --- 4. Include Paths (-I) ---
INCLUDES := -I./include

# Only include directories that actually exist on disk:
INCLUDES += $(call add_inc, $(SPECTRA_DIR)/include $(SPECTRA_DIR))
INCLUDES += $(call add_inc, $(ALGLIB_DIR)/src $(ALGLIB_DIR))
INCLUDES += $(call add_inc, $(ITENSOR_DIR) $(ITENSOR_DIR)/itensor)

# Eigen
INCLUDES += $(call add_inc, $(EIGEN_INC) $(EIGEN_ROOT)/include/eigen3 $(EIGEN_ROOT)/include /usr/include/eigen3)

# CGAL
INCLUDES += $(call add_inc, $(CGAL_INC) $(CGAL_ROOT)/include)

# Boost
INCLUDES += $(call add_inc, $(BOOST_INC) $(BOOST_ROOT)/include)

# Armadillo
INCLUDES += $(call add_inc, $(ARMADILLO_INC) $(ARMADILLO_ROOT)/include)

# OpenBLAS
INCLUDES += $(call add_inc, $(OPENBLAS_INC) $(OPENBLAS_ROOT)/include)

INCLUDES += $(call add_inc, /usr/include)

# --- 5. Linker Paths (-L) and RPATH ---
LDFLAGS := -fopenmp

LDFLAGS += $(call add_lib, $(ARMADILLO_LIB) $(ARMADILLO_ROOT)/lib64 $(ARMADILLO_ROOT)/lib)
LDFLAGS += $(call add_lib, $(BOOST_LIB) $(BOOST_ROOT)/lib64 $(BOOST_ROOT)/lib)
LDFLAGS += $(call add_lib, $(OPENBLAS_LIB) $(OPENBLAS_ROOT)/lib64 $(OPENBLAS_ROOT)/lib)
LDFLAGS += $(call add_lib, $(CGAL_LIB) $(CGAL_ROOT)/lib64 $(CGAL_ROOT)/lib)
LDFLAGS += $(call add_lib, $(ITENSOR_DIR)/lib $(ITENSOR_DIR)/build)
LDFLAGS += $(call add_lib, /usr/lib64 /usr/lib)

# ITensor lib

# --- 6. Libraries to Link (-l) ---
LIBS := -litensor -larmadillo -lopenblas -llapack -lblas -lgmp -lmpfr -lboost_system -lboost_thread -ldl -lm

# --- 7. Sources and Objects ---
OBJ_DIR     := obj_tchenla
SRC_DIR     := src

# Find all source files, excluding main_splines.cpp
ALL_SRCS    := $(shell find $(SRC_DIR) -name "*.cpp")
SRCS        := $(filter-out $(SRC_DIR)/main_splines.cpp, $(ALL_SRCS))
OBJS        := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/src/%.o,$(SRCS))

# ALGLIB sources and objects
ifneq ($(ALGLIB_DIR),)
    ALGLIB_SRCS := $(wildcard $(ALGLIB_DIR)/src/*.cpp)
    ALGLIB_OBJS := $(patsubst $(ALGLIB_DIR)/src/%.cpp,$(OBJ_DIR)/alglib/%.o,$(ALGLIB_SRCS))
else
    ALGLIB_SRCS :=
    ALGLIB_OBJS :=
endif

TARGET := lattice_triangulation

# --- 8. Build Rules ---
.PHONY: all clean info check-dirs

all: info check-dirs $(TARGET)

check-dirs:
	@mkdir -p $(OBJ_DIR)/src $(OBJ_DIR)/src/mesh $(OBJ_DIR)/src/optimization $(OBJ_DIR)/src/experiments $(OBJ_DIR)/alglib

# Link executable
$(TARGET): $(OBJS) $(ALGLIB_OBJS)
	@echo "Linking $(TARGET)..."
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS) $(LIBS)
	@echo "=================================================="
	@echo "  Build SUCCESS: $(TARGET) is ready!"
	@echo "=================================================="

# Compile project C++ sources
$(OBJ_DIR)/src/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling $<"
	$(CXX) $(CXXFLAGS) $(DEFINES) $(INCLUDES) -c $< -o $@

# Compile ALGLIB C++ sources
$(OBJ_DIR)/alglib/%.o: $(ALGLIB_DIR)/src/%.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling ALGLIB $<"
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

clean:
	@echo "Cleaning objects and $(TARGET)..."
	rm -rf $(OBJ_DIR) $(TARGET)
	@echo "Clean completed."

info:
	@echo "=================================================="
	@echo "  Tchenla Cluster Build Configuration"
	@echo "=================================================="
	@echo "  CXX:            $(CXX)"
	@echo "  CXXFLAGS:       $(CXXFLAGS)"
	@echo "  OpenBLAS:       $(OPENBLAS_ROOT) (INC: $(OPENBLAS_INC), LIB: $(OPENBLAS_LIB))"
	@echo "  Boost:          $(BOOST_ROOT) (INC: $(BOOST_INC), LIB: $(BOOST_LIB))"
	@echo "  Armadillo:      $(ARMADILLO_ROOT)"
	@echo "  CGAL:           $(CGAL_ROOT)"
	@echo "  Eigen3:         $(EIGEN_ROOT)"
	@echo "  ALGLIB:         $(ALGLIB_DIR)"
	@echo "  ITensor:        $(ITENSOR_DIR)"
	@echo "  Spectra:        $(SPECTRA_DIR)"
	@echo "=================================================="
